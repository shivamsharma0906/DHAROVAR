# Supabase Credentials (Required for Welfare & Publications data storage)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin Authentication (Optional - defaults to admin / dharovar2026 if unset)
VITE_ADMIN_ID=admin
VITE_ADMIN_PASSWORD=dharovar2026

# Web3Forms API Key for Contact / Inquiries form (Optional)
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
